      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeToDoc.Repository\CodeToDoc.Repository.csproj" />
    <ProjectReference Include="..\CodeToDoc.Service\CodeToDoc.Service.csproj" />
    <ProjectReference Include="..\CodeToDoc.Infrastructure\CodeToDoc.Infrastructure.csproj" />
  </ItemGroup>

</Project>
